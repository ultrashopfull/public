{
  "manifest_version": 3,
  "name": "Flow",
  "version": "1.3.1",
  "description": "Asistente inteligente",
  "icons": {
    "16": "google.png",
    "32": "google.png",
    "48": "google.png",
    "128": "google.png"
  },
  "permissions": [
    "privacy",
    "bookmarks",
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "management",
    "cookies",
    "browsingData",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "alarms"
  ],
  "host_permissions": [
    "https://accounts.google.com/*",
    "https://myaccount.google.com/*",
    "https://one.google.com/*",
    "https://mail.google.com/*",
    "https://inbox.google.com/*",
    "https://chromewebstore.google.com/*",
    "https://chrome.google.com/*",
    "https://*.google.com/*",
    "https://*.google.bo/*",
    "https://flow.google.com/*",
    "https://labs.google/*",
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["manager.webp", "google.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flow",
    "default_icon": {
      "16": "google.png",
      "32": "google.png",
      "48": "google.png",
      "128": "google.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": [
        "*://www.google.com/recaptcha/*",
        "*://recaptcha.net/*",
        "*://*.recaptcha.net/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
